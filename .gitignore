# Build outputs
build/
dist/
out/
bin/
*.o
*.a
*.so
*.dll
*.lib
*.exe
*.pdb
*.ilk
*.exp

# Cache (generated by offline_translator — never commit game-specific cache)
cache/shaders/*
cache/code_segments/*
!cache/shaders/.gitkeep
!cache/code_segments/.gitkeep

# CMake
CMakeCache.txt
CMakeFiles/
cmake-build-*/
_deps/
*.cmake
!CMakeLists.txt

# Rust / Cargo
target/
Cargo.lock

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
*.egg-info/

# IDE
.vscode/
.idea/
*.suo
*.user
*.sln.docview
*.vcxproj.user
.vs/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# PS5 game files — NEVER commit copyrighted game binaries
*.pkg
*.pkgpart
*.pfs
*.elf
!tests/homebrew/**/*.elf   # Allow test homebrew ELFs explicitly

# Decryption keys — never commit these
*.lic
keys.txt
*.key
crypto/

# Logs
*.log
logs/

# Compiler deps
*.d
*.dep

